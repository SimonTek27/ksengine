# =============================================================================
# Kinetika / ksengine — .gitignore
# =============================================================================
# Build artifacts, IDE noise, Qt codegen, runtime data.
# Keep hand-written cmake/*.cmake tracked (shader rules, install layout).
# =============================================================================

# --- Build trees -------------------------------------------------------------
build/
build_*/
out/
dist/
Release/
Debug/
MinSizeRel/
RelWithDebInfo/
lib/
*.dir/
*_autogen/
kseditor_lib.dir/
kseditor_lib_autogen/

# --- CMake generated ---------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
CPackConfig.cmake
CPackSourceConfig.cmake
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
*.cmake
!CMakeLists.txt
# Hand-written modules under cmake/ (KsShaders.cmake, KsInstallLayout.cmake, …)
!cmake/*.cmake

# --- Visual Studio / MSVC / IDE ----------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
kseditor.slnx
*.sln
!*.sln.example

# --- Qt (editor only) --------------------------------------------------------
.qt/
*.moc
moc_*.cpp
moc_*.cpp_parameters
*.moc_parameters
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
*.moch

# --- Compiled objects & binaries ---------------------------------------------
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.a
*.dll
*.exe
*.so
*.dylib
*.spv.bak
!LICENSE.txt

# --- Logs & one-off build output ---------------------------------------------
*.log
build_output*.txt
build_*.txt
build2.txt
build_engine_*.txt
msbuild.log
help_output.txt
stderr.txt
stdout.txt
IntegrationSummary.txt
ed*.txt
single_file_errors.txt

# --- Tests & generated verification ------------------------------------------
test_*.txt
test_*.out
test_*.err
test_*.xml
test_*.tmp
test_results/
anim_test.*
test.ksproj
ctest_phase1_status.txt
ks_dist_log.txt

# --- Runtime data (ksim writes these; layout ships them empty) ----------------
# See cmake/KsInstallLayout.cmake and docs/ksengine_architecture.md
/user/
/content/local/
NUL.obj
vc140.pdb

# --- Python / tools ----------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
tools/__pycache__/

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~

# --- External / third-party checkout noise -----------------------------------
external/openxr/
7zip/
bullet/
vhacd/
mikktspace.dir/
template/

# --- Cleanup 2026-10-20: do not re-commit these -----------------------------
*.i
*.pid
smoke_*.txt
smoke_*.log
backups/
milliken_extract/
*.zip
!content/**/*.zip
