# Expand embedded SimulationLoop.cpp from cmake/simloop_z*.b64 (zlib+b64).
# Triggers on: missing file, #error stub, restore marker, or split .inc includes.
set(_ks_sl "${CMAKE_SOURCE_DIR}/src/simulator/SimulationLoop.cpp")
set(_ks_need_expand FALSE)
if(NOT EXISTS "${_ks_sl}")
  set(_ks_need_expand TRUE)
else()
  file(READ "${_ks_sl}" _ks_head LIMIT 800)
  if(_ks_head MATCHES "restore_simloop|#error|SimulationLoop_p0|split includes")
    set(_ks_need_expand TRUE)
  endif()
endif()

if(_ks_need_expand)
  message(STATUS "ksengine: expanding embedded SimulationLoop.cpp from archive...")
  set(_ks_b64 "")
  foreach(_i RANGE 0 4)
    set(_f "${CMAKE_SOURCE_DIR}/cmake/simloop_z${_i}.b64")
    if(EXISTS "${_f}")
      file(READ "${_f}" _chunk)
      string(STRIP "${_chunk}" _chunk)
      string(APPEND _ks_b64 "${_chunk}")
    endif()
  endforeach()
  if(_ks_b64 STREQUAL "")
    message(WARNING "ksengine: no simloop_z*.b64 found — run tools/restore_simloop.sh")
  else()
    set(_ks_b64f "${CMAKE_BINARY_DIR}/_simloop.b64")
    file(WRITE "${_ks_b64f}" "${_ks_b64}")
    set(_ks_py "${CMAKE_BINARY_DIR}/_expand_simloop.py")
    file(WRITE "${_ks_py}" "import zlib,base64,sys\nopen(sys.argv[2],'wb').write(zlib.decompress(base64.b64decode(open(sys.argv[1]).read())))\n")
    execute_process(COMMAND python3 "${_ks_py}" "${_ks_b64f}" "${_ks_sl}" RESULT_VARIABLE _ks_rc)
    if(_ks_rc EQUAL 0)
      message(STATUS "ksengine: SimulationLoop.cpp restored (52742 bytes expected, FeatureTick included)")
    else()
      message(WARNING "ksengine: expand failed — run tools/restore_simloop.sh")
    endif()
  endif()
endif()
