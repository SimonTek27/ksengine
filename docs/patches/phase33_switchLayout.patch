+bool SimulationLoop::switchLayout(const std::string& layoutId) {
+    namespace fs = std::filesystem;
+    if (m_trackData.directory.empty()) {
+        std::fprintf(stderr, "SimulationLoop::switchLayout: no track loaded\n");
+        return false;
+    }
+    if (m_layouts.empty())
+        m_layouts.discover(m_trackData.directory);
+    if (!m_layouts.selectById(layoutId)) {
+        std::fprintf(stderr, "SimulationLoop::switchLayout: unknown layout '%s'\n",
+                     layoutId.c_str());
+        return false;
+    }
+    const auto* lay = m_layouts.active();
+    if (!lay) return false;
+
+    const std::string folder = lay->folder.empty() ? m_trackData.directory : lay->folder;
+    m_trackData.layoutId = lay->id;
+    m_trackData.layoutFolder = folder;
+
+    float length = lay->lengthM;
+    std::string displayName = lay->name;
+    const fs::path dataJson = fs::path(folder) / "data" / "data.json";
+    if (fs::exists(dataJson)) {
+        ks::ac::TrackDataJsonLoader trackJson;
+        if (trackJson.loadFile(dataJson.string())) {
+            if (trackJson.meta().lengthM > 1.f)
+                length = trackJson.meta().lengthM;
+            if (!trackJson.meta().name.empty())
+                displayName = trackJson.meta().name;
+        }
+    }
+    if (length > 1.f)
+        m_trackData.splineLength = length;
+    if (!displayName.empty())
+        m_trackData.name = displayName;
+
+    std::string kn5;
+    std::error_code ec;
+    if (fs::is_directory(folder, ec)) {
+        for (auto& e : fs::directory_iterator(folder, ec)) {
+            if (ec) break;
+            if (e.path().extension() == ".kn5") {
+                kn5 = e.path().string();
+                break;
+            }
+        }
+    }
+    if (!kn5.empty()) {
+        m_trackData.kn5Path = kn5;
+        applyTrackVisuals(folder);
+    }
+
+    m_ui.menu().setTrackName(m_trackData.name);
+    m_lapTimer.configure(3);
+    m_lapDistance = 0.f;
+    m_normalizedSpline = 0.f;
+    m_trackData.valid = true;
+    m_trackLoaded = true;
+    std::fprintf(stderr, "SimulationLoop: switched layout '%s' (%s) length=%.1f\n",
+                 lay->id.c_str(), m_trackData.name.c_str(), m_trackData.splineLength);
+    return true;
+}
