{
  "schema": "ksengine.ppfilter/1",
  "name": "Performance Max",
  "description": "Disables expensive effects (DOF, glare, god rays, chromatic aberration) for maximum FPS.",
  "category": "performance",
  "autoExposure": {
    "enabled": false,
    "delay": 0.0,
    "min": 0.2,
    "max": 0.5,
    "target": 0.32,
    "meteringWidth": 100.0,
    "meteringHeight": 100.0,
    "meteringOffsetX": 0.0,
    "meteringOffsetY": 0.0,
    "influencedByGlare": false
  },
  "toneMapping": {
    "hdr": false,
    "exposure": 0.28,
    "gamma": 1.2,
    "function": -1,
    "mappingFactor": 32.0,
    "scaleWidth": 1.0,
    "scaleHeight": 1.0,
    "offsetX": 0.0,
    "offsetY": 0.0
  },
  "depthOfField": {
    "enabled": false,
    "quality": 0,
    "apertureFNumber": 12.0,
    "imageSensorHeight": 0.24,
    "baseFOV": 50.0,
    "adaptiveApertureFactor": 0.5,
    "apertureParameter": 2.0,
    "apertureFrontLevels": -1,
    "apertureBackLevels": -1,
    "backgroundMaskThreshold": 0.1,
    "edgeQuality": 0,
    "apertureShape": 3
  },
  "chromaticAberration": {
    "enabled": false,
    "samples": 3,
    "lateralDispersion": [0.005, 0.005],
    "uniformDispersion": [0.0005, 0.0005]
  },
  "vignetting": {
    "strength": 0.035,
    "fovDependence": 0.0
  },
  "glare": {
    "enabled": false,
    "quality": 1,
    "ghost": false,
    "afterImage": false,
    "precision": 0,
    "anamorphic": false,
    "luminance": 1.6,
    "shape": 11,
    "blur": false,
    "threshold": 5.0,
    "brightPass": false
  },
  "godRays": {
    "enabled": false,
    "useSunLight": true,
    "diffractionRing": 0.25,
    "diffractionRingRadius": 5.0,
    "diffractionRingAttenuation": 0.1,
    "diffractionRingOuterColor": [0.5, 0.5, 0.5, 0.5],
    "color": [1.0, 1.0, 1.0, 1.0],
    "length": 11.0,
    "glareRatio": 0.005,
    "angleAttenuation": 5.0
  },
  "colorGrading": {
    "hue": 0.0,
    "saturation": 0.95,
    "brightness": 1.0,
    "contrast": 1.0,
    "sepia": 0.0,
    "colorTemp": 6400,
    "whiteBalance": 6400
  }
}
