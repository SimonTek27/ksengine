{
  "schema": "ksengine.ppfilter/1",
  "name": "Cinematic Warm",
  "description": "Warm tones with subtle bloom, shallow DOF and a gentle vignette.",
  "category": "cinematic",
  "autoExposure": {
    "enabled": true,
    "delay": 0.0,
    "min": 0.2,
    "max": 0.5,
    "target": 0.32,
    "meteringWidth": 100.0,
    "meteringHeight": 100.0,
    "meteringOffsetX": 0.0,
    "meteringOffsetY": 0.0,
    "influencedByGlare": true
  },
  "toneMapping": {
    "hdr": true,
    "exposure": 0.35,
    "gamma": 1.1,
    "function": -1,
    "mappingFactor": 32.0,
    "scaleWidth": 1.0,
    "scaleHeight": 1.0,
    "offsetX": 0.0,
    "offsetY": 0.0
  },
  "depthOfField": {
    "enabled": false,
    "quality": 3,
    "apertureFNumber": 8.0,
    "imageSensorHeight": 0.24,
    "baseFOV": 50.0,
    "adaptiveApertureFactor": 0.5,
    "apertureParameter": 2.0,
    "apertureFrontLevels": -1,
    "apertureBackLevels": -1,
    "backgroundMaskThreshold": 0.1,
    "edgeQuality": 3,
    "apertureShape": 3
  },
  "chromaticAberration": {
    "enabled": true,
    "samples": 5,
    "lateralDispersion": [0.005, 0.005],
    "uniformDispersion": [0.0005, 0.0005]
  },
  "vignetting": {
    "strength": 0.08,
    "fovDependence": 0.0
  },
  "glare": {
    "enabled": true,
    "quality": 3,
    "ghost": true,
    "afterImage": false,
    "precision": 0,
    "anamorphic": false,
    "luminance": 2.0,
    "shape": 11,
    "blur": true,
    "threshold": 3.0,
    "brightPass": false
  },
  "godRays": {
    "enabled": true,
    "useSunLight": true,
    "diffractionRing": 0.25,
    "diffractionRingRadius": 5.0,
    "diffractionRingAttenuation": 0.1,
    "diffractionRingOuterColor": [0.5, 0.45, 0.35, 0.5],
    "color": [1.0, 0.95, 0.85, 1.0],
    "length": 11.0,
    "glareRatio": 0.005,
    "angleAttenuation": 5.0
  },
  "colorGrading": {
    "hue": 0.0,
    "saturation": 1.1,
    "brightness": 1.0,
    "contrast": 1.05,
    "sepia": 0.0,
    "colorTemp": 5500,
    "whiteBalance": 5500
  }
}
