{
  "schema": "ksengine.ppfilter/1",
  "name": "Retro 90s",
  "description": "Desaturated grunge look with chromatic aberration and soft vignette.",
  "category": "vintage",
  "autoExposure": {
    "enabled": true,
    "delay": 0.3,
    "min": 0.3,
    "max": 0.7,
    "target": 0.38,
    "meteringWidth": 100.0,
    "meteringHeight": 100.0,
    "meteringOffsetX": 0.0,
    "meteringOffsetY": 0.0,
    "influencedByGlare": false
  },
  "toneMapping": {
    "hdr": true,
    "exposure": 0.28,
    "gamma": 1.1,
    "function": -1,
    "mappingFactor": 32.0,
    "scaleWidth": 1.0,
    "scaleHeight": 1.0,
    "offsetX": 0.0,
    "offsetY": 0.0
  },
  "depthOfField": {
    "enabled": false,
    "quality": 2,
    "apertureFNumber": 5.6,
    "imageSensorHeight": 0.032,
    "baseFOV": 50.0,
