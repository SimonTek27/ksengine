{
  "schema": 1,
  "engine": {
    "name": "KinetiKa Simulator",
    "config": "system/cfg/ksengine.json",
    "playerOverrides": "user/<player>/settings.json",
    "precedence": "system/cfg first, user file second, later wins per key",
    "note": "Sections below mirror the menu sections that exist in the simulator. Each section lists its effective values and where every Content Manager page and Custom Shaders Patch module lands. Only physics.fixedDt, audio.master, assist.tc and assist.abs are consumed by the runtime today; every other key is documentation and is ignored by the loader, so it can never break a session."
  },
  "effectiveKeys": [
    "physics.fixedDt",
    "audio.master",
    "assist.tc",
    "assist.abs"
  ],
  "physics": {
    "fixedDt": 0.008333333333333333,
    "note": "Fixed simulation step in seconds, accepted range 1e-5..1.0; 1/120 is the compiled default."
  },
  "assist": {
    "tc": 0,
    "abs": 0,
    "note": "Driver aids applied from the setup at start-up only, 0..12."
  },
  "settings": {
    "entries": [
      "video",
      "audio",
      "controls"
    ],
    "from": [
      "cm:settings/content-manager",
      "cm:settings/assetto-corsa",
      "cm:settings/custom-shaders-patch"
    ],
    "note": "Content Manager splits its settings across three panels; in KinetiKa they are three entries of the same SETTINGS screen, with the Custom Shaders Patch pages folded into the two below (image) and one (input)."
  },
  "video": {
    "resolution": "1920x1080",
    "resolutions": [
      "1920x1080",
      "1600x900",
      "1280x720"
    ],
    "fullscreen": false,
    "vsync": true,
    "frameLimit": 0,
    "ssao": false,
    "ssr": false,
    "motionBlur": false,
    "exposure": 0.72,
    "tonemap": "ACES",
    "tonemaps": [
      "NONE",
      "REINHARD",
      "ACES",
      "UNCHARTED2",
      "FILMIC"
    ],
    "postProcessFilter": "Normal",
    "hdrOutput": false,
    "msaa": 1,
    "anisotropicFiltering": 8,
    "shadowMapSize": 2048,
    "mirrorResolution": "128x512",
    "sources": [
      {
        "from": "ac:cfg/video.ini",
        "status": "live",
        "landsAs": "resolution, fullscreen, vsync, anisotropic, shadow map, AA samples",
        "note": "Resolution, fullscreen and vsync switch the window and the swapchain at runtime; anisotropic filtering and the shadow map size are fixed when assets load."
      },
      {
        "from": "csp:graphics_adjustments",
        "status": "partial",
        "landsAs": "exposure, tonemap",
        "note": "Only the parts the display pass honours: exposure and tone curve. The rest of the page has no equivalent pass."
      },
      {
        "from": "csp:lighting_fx",
        "status": "missing",
        "landsAs": null,
        "note": "No emissive/light bloom chain in the deferred path."
      },
      {
        "from": "csp:extra_fx",
        "status": "missing",
        "landsAs": null,
        "note": "No SSGI, no screen-space shadows accumulation."
      },
      {
        "from": "csp:reflections_fx",
        "status": "partial",
        "landsAs": "ssr",
        "note": "Screen-space reflections exist; planar/mirror reflections do not."
      },
      {
        "from": "csp:smart_mirror",
        "status": "missing",
        "landsAs": null,
        "note": "No mirror pass; the Value is kept for reference only."
      },
      {
        "from": "csp:smart_shadows",
        "status": "partial",
        "landsAs": "shadowMapSize",
        "note": "One cascade shadow map at a fixed size, no per-frame retargeting."
      },
      {
        "from": "csp:shadowed_wheels",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:colorful_shadowing",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:custom_rendering_modes",
        "status": "partial",
        "landsAs": "deferred pass",
        "note": "Forward and deferred paths exist; the list of named modes does not."
      },
      {
        "from": "csp:data_gbuffer",
        "status": "partial",
        "landsAs": "deferred gbuffer",
        "note": "The deferred path has its own gbuffer layout; per-material overrides are not loaded."
      },
      {
        "from": "csp:grass_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:particles_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:rain_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:windscreen_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:skidmarks_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:fake_shadows_fx",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:tyres_fx",
        "status": "missing",
        "landsAs": null,
        "note": "Tyres render as plain meshes; no deformation or flat-spot visuals."
      },
      {
        "from": "csp:weather_fx",
        "status": "partial",
        "landsAs": "weather preset",
        "note": "A weather state drives sun and sky values; the shader-level weather system is absent."
      },
      {
        "from": "csp:yebisest",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:dxgi_tweaks",
        "status": "missing",
        "landsAs": null,
        "note": "Vulkan swapchain: no DXGI present hooks."
      },
      {
        "from": "csp:vr_tweaks",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:triple_custom",
        "status": "missing",
        "landsAs": null
      },
      {
        "from": "csp:neck",
        "status": "missing",
        "landsAs": null,
        "note": "Camera is rigid; no head physics."
      },
      {
        "from": "csp:freer_camera",
        "status": "partial",
        "landsAs": "orbit camera",
        "note": "A free orbit camera exists for the showroom and the menu backdrop."
      },
      {
        "from": "csp:chaser_camera",
        "status": "partial",
        "landsAs": "chase camera",
        "note": "Chase and cockpit views exist, without the spring/offset tuning of the page."
      },
      {
        "from": "ac:cfg/camera_manager",
        "status": "partial",
        "landsAs": "chase / cockpit cameras",
        "note": "Two views exist and switch; the page's per-camera bookmarks are not read."
      },
      {
        "from": "ac:cfg/camera_onboard",
        "status": "partial",
        "landsAs": "cockpit view",
        "note": "Onboard camera is fixed to the car's cockpit node; no FOV or offset tuning."
      },
      {
        "from": "ac:cfg/triple_screen",
        "status": "missing",
        "landsAs": null,
        "note": "One window, one swapchain: no triple-head splitting or side-angle correction."
      },
      {
        "from": "cm:settings/assetto-corsa/video",
        "status": "partial",
        "landsAs": "video page",
        "note": "The page lists only the knobs the renderer reads back; MSAA, mip LOD bias and frame latency have no implementation."
      },
      {
        "from": "cm:tools/pp-filter-editor",
        "status": "partial",
        "landsAs": "postProcessFilter",
        "note": "Presets are loaded from system/ppfilters at start-up; there is no editor."
      }
    ]
  },
  "audio": {
    "master": 0.8,
    "engineVolume": 1.0,
    "environmentVolume": 1.0,
    "showroomAmbience": true,
    "showroomMusic": true,
    "sources": [
      {
        "from": "ac:cfg/audio.ini",
        "status": "partial",
        "landsAs": "master",
        "note": "Master is a real setting. Engine, wind, tyre and opponent levels are driven per frame by the session, so they are not exposed as preferences."
      },
      {
        "from": "csp:music",
        "status": "live",
        "landsAs": "showroom music channel",
        "note": "The showroom plays ambience and music with declick and headroom; there is no playlists page."
      },
      {
        "from": "cm:settings/content-manager/audio",
        "status": "live",
        "landsAs": "master volume row"
      }
    ]
  },
