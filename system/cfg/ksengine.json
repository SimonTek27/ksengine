{
  "schema": 1,
  "engine": {
    "name": "KinetiKa Simulator",
    "config": "system/cfg/ksengine.json",
    "playerOverrides": "user/<player>/settings.json",
    "precedence": "system/cfg first, user file second, later wins per key",
    "note": "Sections below mirror the menu sections that exist in the simulator. Each section lists its effective values and the features it owns, with the status each one has today. Only physics.fixedDt, audio.master, assist.tc and assist.abs are consumed by the runtime; every other key is documentation and is ignored by the loader, so it can never break a session."
  },
  "effectiveKeys": [
    "physics.fixedDt",
    "audio.master",
    "assist.tc",
    "assist.abs"
  ],
  "physics": {
    "fixedDt": 0.008333333333333333,
    "note": "Fixed simulation step in seconds, accepted range 1e-5..1.0; 1/120 is the compiled default."
  },
  "assist": {
    "tc": 0,
    "abs": 0,
    "note": "Driver aids applied from the setup at start-up only, 0..12."
  },
  "settings": {
    "entries": [
      "video",
      "audio",
      "controls"
    ],
    "note": "The three entries of the SETTINGS screen: every image option lives in the video page, the volumes in audio, the bindings in controls."
  },
  "video": {
    "resolution": "1920x1080",
    "resolutions": [
      "1920x1080",
      "1600x900",
      "1280x720"
    ],
    "fullscreen": false,
    "vsync": true,
    "frameLimit": 0,
    "ssao": false,
    "ssr": false,
    "motionBlur": false,
    "exposure": 1.0,
    "tonemap": "ACES",
    "tonemaps": [
      "NONE",
      "REINHARD",
      "ACES",
      "UNCHARTED2",
      "FILMIC"
    ],
    "postProcessFilter": "Normal",
    "hdrOutput": false,
    "msaa": 1,
    "anisotropicFiltering": 8,
    "shadowMapSize": 2048,
    "mirrorResolution": "128x512",
    "particles": true,
    "sources": [
      {
        "feature": "windowOutput",
        "status": "live",
        "landsAs": "resolution, fullscreen, vsync, frame limit, anisotropic, shadow map, AA samples",
        "note": "Resolution, fullscreen and vsync switch the window and the swapchain; the frame limit paces the loop (0 = vsync only) and the anisotropy number caps the material samplers at the device limit. All of it comes from this file."
      },
      {
        "feature": "displayTuning",
        "status": "live",
        "landsAs": "exposure, tonemap",
        "note": "Exposure and the tone curve are read from this file at startup, applied after the post preset, and the page reads them back from the renderer."
      },
      {
        "feature": "bloomAndFlare",
        "status": "partial",
        "landsAs": "bloom (bright pass + separable blur)",
        "note": "Bloom is a real half-resolution pass - glare extract, blur H, blur V - feeding the display pass. Occlusion-driven lens flare is not implemented."
      },
      {
        "feature": "ssgi",
        "status": "missing",
        "landsAs": null,
        "note": "SSGIRenderer and its compute shader exist in engine/graphics, but no renderer pass instantiates them: the frame never runs the trace."
      },
      {
        "feature": "screenSpaceReflections",
        "status": "partial",
        "landsAs": "ssr",
        "note": "Screen-space reflections exist; planar and mirror reflections do not."
      },
      {
        "feature": "mirrors",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "shadowMap",
        "status": "partial",
        "landsAs": "shadowMapSize",
        "note": "One cascade shadow map at a fixed size, without per-frame retargeting."
      },
      {
        "feature": "wheelShadowing",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "coloredShadows",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "renderModes",
        "status": "partial",
        "landsAs": "deferred pass",
        "note": "Forward and deferred paths exist; the list of named modes does not."
      },
      {
        "feature": "gbufferLayout",
        "status": "partial",
        "landsAs": "deferred gbuffer",
        "note": "The deferred path has its own gbuffer layout; per-material overrides are not loaded."
      },
      {
        "feature": "grass",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "particles",
        "status": "live",
        "landsAs": "billboard sprite quads (dust, rain, spray)",
        "note": "video.particles starts the ParticleSystem emitters and the billboard pass draws them; KS_PARTICLES=1 still forces them on for a capture."
      },
      {
        "feature": "rain",
        "status": "live",
        "landsAs": "weather rain shading + drops/spray",
        "note": "The lighting pass reads rain intensity and track wetness from the weather every frame, and the drops and spray come from the particle emitters video.particles starts."
      },
      {
        "feature": "windscreenEffects",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "skidmarks",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "tyreVisuals",
        "status": "missing",
        "landsAs": null,
        "note": "Tyres render as plain meshes: no deformation or flat-spot visuals."
      },
      {
        "feature": "weatherShaders",
        "status": "partial",
        "landsAs": "weather preset",
        "note": "A weather state drives sun and sky values; shader-level weather is absent."
      },
      {
        "feature": "postChain",
        "status": "partial",
        "landsAs": "postProcessFilter",
        "note": "The native display pass applies exposure, the tone curve and the ppfilter LUT; no external post-processing middleware is involved."
      },
      {
        "feature": "vrSupport",
        "status": "missing",
        "landsAs": null
      },
      {
        "feature": "tripleScreen",
        "status": "missing",
        "landsAs": null,
        "note": "One window, one swapchain: no triple-head splitting or side-angle correction."
      },
      {
        "feature": "headPhysics",
        "status": "partial",
        "landsAs": "cockpit head spring",
        "note": "Longitudinal and lateral acceleration sway the cockpit head through a spring-damper; vertical suspension travel is not fed in yet."
      },
      {
        "feature": "freeCamera",
        "status": "partial",
        "landsAs": "orbit camera",
        "note": "A free orbit camera exists for the showroom and the menu backdrop."
      },
      {
        "feature": "chaseCamera",
        "status": "partial",
        "landsAs": "chase camera",
        "note": "Chase and cockpit views exist, without spring or offset tuning."
      },
      {
        "feature": "cameraViews",
        "status": "partial",
        "landsAs": "chase / cockpit cameras",
        "note": "Two views exist and switch; its per-camera bookmarks are not read."
      },
      {
        "feature": "cockpitCamera",
        "status": "partial",
        "landsAs": "cockpit view",
        "note": "Onboard camera is fixed to the car's cockpit node; no FOV or offset tuning."
      }
    ],
    "headPhysics": true
  },
  "audio": {
    "master": 0.8,
    "engineVolume": 1.0,
    "environmentVolume": 1.0,
    "showroomAmbience": true,
    "showroomMusic": true,
    "sources": [
      {
        "feature": "channelLevels",
        "status": "partial",
        "landsAs": "master",
        "note": "Master is a real setting. Engine, wind, tyre and opponent levels are driven per frame by the session, so they are not exposed as preferences."
      },
      {
        "feature": "musicPlayer",
        "status": "live",
        "landsAs": "showroom music channel",
        "note": "The showroom plays ambience and music with declick and headroom; there is no playlists screen."
      },
      {
        "feature": "masterVolume",
        "status": "live",
        "landsAs": "master volume row"
      }
    ]
  },
  "controls": {
